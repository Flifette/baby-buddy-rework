# With `docker compose --profile full up -d`, keep the internal service URL below.
# For an existing Baby Buddy instance, replace it with a URL reachable from the container.
BABY_BUDDY_URL=http://babybuddy:8000
BABY_BUDDY_API_KEY=your_api_key_here
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace_with_a_unique_password_of_at_least_16_characters
REFRESH_INTERVAL=30
UNIT_SYSTEM=metric
DEMO_MODE=false
TZ=Europe/Paris
